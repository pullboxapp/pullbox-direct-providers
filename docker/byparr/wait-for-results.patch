+class _AnnaSearchPage(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__()
+        self.in_search_form = False
+        self.has_query = False
+        self.ready = False
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        values = dict(attrs)
+        if tag == "form":
+            self.in_search_form = values.get("action") == "/search"
+        if tag == "input" and self.in_search_form and values.get("name") == "q":
+            self.has_query = True
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag == "form":
+            self.ready = self.ready or (self.in_search_form and self.has_query)
+            self.in_search_form = False
+
+
+async def _wait_for_anna_search(dep: BrowserDep, timer: TimeoutTimer) -> str:
+    """Wait for the source search shell, not an idle browser or a transient title."""
+    cloudflare_attempted = False
+    while timer.remaining() > 0:
+        try:
+            html = await dep.page.content()
+            title = (await dep.page.title()).strip().casefold()
+            page = _AnnaSearchPage()
+            page.feed(html)
+            if page.ready and "search" in title and not title.startswith("loading"):
+                return html
+            if (
+                not cloudflare_attempted
+                and title != "ddos-guard"
+                and not title.startswith("loading")
+                and await challenge_present(dep.page)
+            ):
+                cloudflare_attempted = True
+                await solve_challenge(dep.page, timer)
+                continue
+        except PlaywrightError as exc:
+            if "Execution context was destroyed" not in str(exc):
+                raise
+        await sleep(min(0.25, timer.remaining()))
+    message = "Anna search page was not ready before the request deadline"
+    raise TimeoutError(message)
+
+
+async def _wait_for_ddos_guard(dep: BrowserDep, timer: TimeoutTimer) -> None:
+    """Observe navigation without injecting scripts into the interstitial."""
+    while timer.remaining() > 0:
+        await sleep(min(0.25, timer.remaining()))
+        try:
+            title = (await dep.page.title()).strip().casefold()
+        except PlaywrightError as exc:
+            if "Execution context was destroyed" in str(exc):
+                continue
+            raise
+        if title and title != "ddos-guard" and not title.startswith("loading"):
+            return
+    message = "DDoS-Guard still present when the request budget ran out"
+    raise TimeoutError(message)
+
