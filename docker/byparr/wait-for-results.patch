+async def _wait_for_ddos_guard(dep: BrowserDep, timer: TimeoutTimer) -> None:
+    """Observe navigation without injecting scripts into the interstitial."""
+    while timer.remaining() > 0:
+        await sleep(min(0.25, timer.remaining()))
+        try:
+            title = (await dep.page.title()).strip().casefold()
+        except PlaywrightError as exc:
+            if "Execution context was destroyed" in str(exc):
+                continue
+            raise
+        if title and title != "ddos-guard" and not title.startswith("loading"):
+            return
+    raise TimeoutError("DDoS-Guard still present when the request budget ran out")
+
